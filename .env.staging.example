# ─────────────────────────────────────────────────────────────────────────────
# STAGING environment delta — copy over a .env made from .env.example.
# UAT/preview environment: staging.sewahospitality.com, basic-auth/CF-Access
# gated, noindex, demo-seeded fixtures (06-hosting-deployment §6).
# Secrets stay in the host's real .env (0600) — NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=staging
APP_DEBUG=false
APP_URL="https://staging.sewahospitality.com"

# Staging disables indexation at the edge + headers (hosting §6).
LOG_LEVEL=info

# MySQL 8 (hosting §1: InnoDB, utf8mb4, strict).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sewa_staging
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=".sewahospitality.com"

# Mail: Resend primary, Hostinger SMTP failover (10-email §2; keys on host).
MAIL_MAILER=resend
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=

# Real subdomains on staging: the site host runs all surfaces.
SEWA_DOMAIN_SITE="staging.sewahospitality.com"
SEWA_DOMAIN_ADMIN="staging-admin.sewahospitality.com"
SEWA_DOMAIN_APP="staging-app.sewahospitality.com"
SEWA_DOMAIN_API="staging-api.sewahospitality.com"
SEWA_DOMAIN_MEDIA="staging-media.sewahospitality.com"

# Host path OUTSIDE the app dir per hosting §8: /home/uXXXX/backups.
SEWA_BACKUPS_PATH="/home/uXXXX/backups"
SEWA_ENABLE_DEV_ROUTES=true

# Turnstile: real test keys registered for the staging subdomains.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_FAIL_MODE=strict

# Cloudflare proxies sit in front — restore real client IPs.
TRUSTED_PROXIES="173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22"

# AI: enabled on staging with real (budgeted) keys; budgets stay tight.
AI_ENABLED=true
AI_KEY_PRIMARY=
AI_KEY_SECONDARY=

SANCTUM_STATEFUL_DOMAINS="staging.sewahospitality.com,staging-app.sewahospitality.com"
CORS_ALLOWED_ORIGINS="https://staging.sewahospitality.com"

RESEND_API_KEY=

SENTRY_LARAVEL_DSN=

# Analytics off on staging (consent-first anyway — empty = off).
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
GA4_API_SECRET=
