# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION environment delta — copy over a .env made from .env.example.
# Live: sewahospitality.com + admin./app./api./media. subdomains, MySQL 8,
# single hPanel cron, Cloudflare in front (06-hosting-deployment §2/§6).
# Real values live ONLY in the host's .env (0600 perms) — never commit.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=production
APP_DEBUG=false
APP_URL="https://sewahospitality.com"

LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sewa_production
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
# Admin rides a separate cookie domain (security §1.1) — root domain still
# shares the portal session; refine per 02-architecture §4 if split further.
SESSION_DOMAIN=".sewahospitality.com"

MAIL_MAILER=resend
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=

SEWA_DOMAIN_SITE="sewahospitality.com"
SEWA_DOMAIN_ADMIN="admin.sewahospitality.com"
SEWA_DOMAIN_APP="app.sewahospitality.com"
SEWA_DOMAIN_API="api.sewahospitality.com"
SEWA_DOMAIN_MEDIA="media.sewahospitality.com"

SEWA_BACKUPS_PATH="/home/uXXXX/backups"
SEWA_ENABLE_DEV_ROUTES=false

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_FAIL_MODE=strict

TRUSTED_PROXIES="173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22"

AI_ENABLED=true
AI_KEY_PRIMARY=
AI_KEY_SECONDARY=
AI_BUDGET_TRANSLATE_CALLS=5000
AI_BUDGET_TRANSLATE_TOKENS=2000000
AI_BUDGET_ENRICH_CALLS=1000
AI_BUDGET_ENRICH_TOKENS=400000
AI_BUDGET_SUMMARIZE_CALLS=1000
AI_BUDGET_SUMMARIZE_TOKENS=400000
AI_BUDGET_DRAFT_CALLS=2000
AI_BUDGET_DRAFT_TOKENS=800000
AI_BUDGET_SCORE_CALLS=2000
AI_BUDGET_SCORE_TOKENS=200000

SANCTUM_STATEFUL_DOMAINS="sewahospitality.com,app.sewahospitality.com"
CORS_ALLOWED_ORIGINS="https://sewahospitality.com"

RESEND_API_KEY=

SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=

GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
GA4_API_SECRET=
