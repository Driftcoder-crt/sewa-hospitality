APP_NAME="Sewa Hospitality"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

LOG_CHANNEL=stack
LOG_STACK_CHANNELS=single,ops
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=nullable

# MySQL per the stack contract (03-technical-specs/01-stack-and-dependencies
# §5: MySQL 8.x, utf8mb4, InnoDB, strict mode). Tests keep in-memory
# sqlite via phpunit.xml; the app database is MySQL everywhere.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sewa_hospitality
DB_USERNAME=
DB_PASSWORD=

# Cache/queue/session on the database driver (shared-hosting contract:
# no Redis, no daemons — 03-technical-specs/06-hosting-deployment §1).
CACHE_STORE=database
CACHE_PREFIX=sewa_cache
QUEUE_CONNECTION=database
QUEUE_QUEUE=default
SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Mail: local sink = log. Staging/production use Resend + SMTP failover
# (see .env.staging.example / .env.production.example).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@sewahospitality.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

# --- SEWA platform (config/sewa.php) -------------------------------------
# Domains: local collapses to path prefixes (bootstrap/app.php) — these
# stay unset locally.
SEWA_DOMAIN_SITE=
SEWA_DOMAIN_ADMIN=
SEWA_DOMAIN_APP=
SEWA_DOMAIN_API=
SEWA_DOMAIN_MEDIA=

SEWA_ADMIN_IDLE_MINUTES=120
SEWA_EMAIL_HELLO="hello@sewahospitality.com"
SEWA_EMAIL_SUPPORT="support@sewahospitality.com"
SEWA_EMAIL_CAREERS="careers@sewahospitality.com"
SEWA_EMAIL_NOREPLY="no-reply@sewahospitality.com"
SEWA_EMAIL_BILLING="billing@sewahospitality.com"
SEWA_OPS_EMAILS="hello@sewahospitality.com"
SEWA_PRIVACY_VERSION=2026-01
SEWA_MEDIA_MAX_BYTES=8388608
SEWA_BACKUPS_PATH=
SEWA_ENABLE_DEV_ROUTES=true

# Cloudflare Turnstile — keys unset locally: fail_mode=grace keeps forms
# working (honeypot still enforced). NEVER commit real keys.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_FAIL_MODE=grace

# Cloudflare real-IP restore (comma-separated ranges, blank = none).
TRUSTED_PROXIES=

# --- AI layer (config/ai.php) --------------------------------------------
# Kill switch: false = every AI feature takes its native no-AI path.
AI_ENABLED=false
AI_PROVIDER_PRIMARY=tokenrouter
AI_BASE_URL_PRIMARY="https://api.tokenrouter.com/v1"
AI_KEY_PRIMARY=
AI_MODEL_PRIMARY="z-ai/glm-5.3-free"
AI_BASE_URL_SECONDARY="https://openrouter.ai/api/v1"
AI_KEY_SECONDARY=
AI_MODEL_SECONDARY="z-ai/glm-5.3-free"
AI_TIMEOUT_SECONDS=30
AI_CONNECT_TIMEOUT=10
AI_MODEL_TRANSLATE=
AI_MODEL_ENRICH=
AI_MODEL_SUMMARIZE=
AI_MODEL_DRAFT=
AI_MODEL_SCORE=
AI_BUDGET_TRANSLATE_CALLS=0
AI_BUDGET_TRANSLATE_TOKENS=0
AI_BUDGET_ENRICH_CALLS=0
AI_BUDGET_ENRICH_TOKENS=0
AI_BUDGET_SUMMARIZE_CALLS=0
AI_BUDGET_SUMMARIZE_TOKENS=0
AI_BUDGET_DRAFT_CALLS=0
AI_BUDGET_DRAFT_TOKENS=0
AI_BUDGET_SCORE_CALLS=0
AI_BUDGET_SCORE_TOKENS=0

# --- Search (config/scout.php) --------------------------------------------
SCOUT_DRIVER=database
SCOUT_QUEUE=true

# --- Sanctum / CORS --------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_EXPIRATION=
CORS_ALLOWED_ORIGINS=

# --- Mail provider (resend-laravel) ---------------------------------------
# Fallback SMTP creds live in the staging/production examples only.
RESEND_API_KEY=

# --- Monitoring (Sentry) ----------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_RATE=

# --- Analytics (consent-first; empty = fully off) ---------------------------
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
GA4_API_SECRET=

# --- Media pipeline ---------------------------------------------------------
MEDIA_DISK=public
MEDIA_QUEUE=syncs
