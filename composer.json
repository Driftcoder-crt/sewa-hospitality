{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sewa/hospitality-platform",
    "type": "project",
    "description": "SEWA HOSPITALITY SERVICES PVT. LTD. — corporate relocation, global mobility & hospitality platform (Laravel modular monolith).",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ably/laravel-broadcaster": "^1.0",
        "laravel/fortify": "^1.25",
        "laravel/framework": "^13.21",
        "laravel/pulse": "^1.0",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^11.0",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.0",
        "sentry/sentry-laravel": "^4.0",
        "spatie/laravel-honeypot": "^4.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-sitemap": "^7.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\""
        ],
        "test": [
            "@php artisan test --parallel"
        ],
        "lint": [
            "pint --test"
        ],
        "lint:fix": [
            "pint"
        ],
        "audit": [
            "@composer audit"
        ],
        "seed:prod-minimal": [
            "@php artisan db:seed --class=Database\\Seeders\\ProdMinimalSeeder --force"
        ],
        "seed:demo": [
            "@php artisan db:seed --class=Database\\Seeders\\DemoSeeder --force"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.33"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
